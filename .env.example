# Copy to .env, then set TWO different, long random passwords.
# Run this command twice on a machine with OpenSSL: openssl rand -hex 32
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# Set to true ONLY when the app is served through HTTPS.
COOKIE_SECURE=false
# Add reverse-proxy hostnames here, comma-separated and without ports.
ALLOWED_HOSTS=
